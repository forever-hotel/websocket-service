{
  "name": "forever-hotel-websocket-service",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.14 <23",
    "npm": ">=10"
  },
  "scripts": {
    "build": "nest build",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "start:dev": "node --env-file-if-exists=.env ./node_modules/@nestjs/cli/bin/nest.js start --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --runInBand",
    "test:cov": "jest --coverage --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "11.1.27",
    "@nestjs/core": "11.1.27",
    "@nestjs/platform-express": "11.2.5",
    "@nestjs/platform-socket.io": "11.2.7",
    "@nestjs/websockets": "11.2.7",
    "amqplib": "2.2.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.4"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.23",
    "@nestjs/testing": "11.1.27",
    "@types/jest": "30.0.0",
    "@types/node": "24.13.2",
    "jest": "30.5.2",
    "ts-jest": "29.4.15",
    "typescript": "5.9.3",
    "prettier": "3.8.4",
    "eslint": "9.39.4",
    "@eslint/js": "9.39.4",
    "typescript-eslint": "8.61.1",
    "socket.io-client": "4.8.4"
  },
  "overrides": {
    "multer": "2.5.0",
    "body-parser": "2.4.0",
    "qs": "6.17.1"
  },
  "jest": {
    "rootDir": ".",
    "testMatch": [
      "<rootDir>/test/**/*.spec.ts"
    ],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.json"
        }
      ]
    },
    "testEnvironment": "node",
    "setupFiles": [
      "reflect-metadata"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/main.ts",
      "!src/**/*.module.ts"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "json-summary"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 80,
        "branches": 80
      }
    }
  }
}
