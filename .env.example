# Local standalone service. Root Compose supplies these values directly.
PORT=4700
RABBITMQ_URL=amqp://mad:mad-local-only@localhost:5672
# Match the MAD relay key in the private root .env; never commit real values.
WEBSOCKET_SUBSYSTEMS_JSON='{"mad":{"authUrl":"http://localhost:8080/mad/auth/session","relayKey":"replace-with-the-same-private-mad-relay-key","origins":["http://localhost:3000"],"roles":{"MANAGER":["analytics","rooms","kitchen","tasks","stock","notifications"]}}}'
