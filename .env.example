# Local standalone service. Root Compose supplies these values directly.
PORT=8081
RABBITMQ_URL=amqp://mad:mad-local-only@localhost:5672
# Match each subsystem relay key in the private root .env; never commit real values.
WEBSOCKET_SUBSYSTEMS_JSON='{"mad":{"authUrl":"http://localhost:8080/mad/auth/session","relayKey":"replace-with-the-private-mad-relay-key-at-least-32-characters","origins":["http://localhost:3000","http://127.0.0.1:3000"],"roles":{"ROOT":["analytics","rooms","kitchen","tasks","stock","notifications"],"MANAGER":["analytics","rooms","kitchen","tasks","stock","notifications"]}},"fds":{"authUrl":"http://localhost:8080/fds/auth/session","relayKey":"replace-with-the-private-fds-relay-key-at-least-32-characters","origins":["http://localhost:3001","http://127.0.0.1:3001"],"roles":{"ROOT":["rooms","tasks"],"RECEPTIONIST":["rooms","tasks"]}},"wkms":{"authUrl":"http://localhost:8080/wkms/auth/session","relayKey":"replace-with-the-private-wkms-relay-key-at-least-32-characters","origins":["http://localhost:3002","http://127.0.0.1:3002"],"roles":{"ROOT":["tasks"],"WORKER":["tasks"]}},"kms":{"authUrl":"http://localhost:8080/kms/auth/session","relayKey":"replace-with-private-kms-relay-key-at-least-32-characters","origins":["http://localhost:3005","http://127.0.0.1:3005"],"roles":{"ROOT":["kitchen","stock"],"KITCHEN_MANAGER":["kitchen","stock"],"KITCHEN_STAFF":["kitchen"]}}}'
